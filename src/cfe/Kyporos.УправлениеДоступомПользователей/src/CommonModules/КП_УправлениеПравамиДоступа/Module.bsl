// Возвращает Истина, если Пользователь входит в список исключений
//
// Параметры:
//  ПользовательСсылка	 - СправочникСсылка.Пользователи 
// 
// Возвращаемое значение:
//  Булево - Истина, если Пользователь входит в список исключений 
//
Функция ПользовательВСпискеИсключений(ПользовательСсылка)
	
	Если Не ЗначениеЗаполнено(ПользовательСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КП_ИсключенныеПользователиИзОбработки.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.КП_ИсключенныеПользователиИзОбработки КАК КП_ИсключенныеПользователиИзОбработки
	|ГДЕ
	|	КП_ИсключенныеПользователиИзОбработки.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", ПользовательСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Возврат Выборка.Следующий();

КонецФункции

#КонецОбласти

#Область ОбновлениеПравПользователя

// Обновить права доступа пользователя по данным технического пользователя обмена
//
// Параметры:
//  ТехническийПользовательОбмена	 - СправочникСсылка.КП_ПользователиТекущейИС 
//  ПользовательСсылка				 - СправочникСсылка.Пользователи
//
Процедура ОбновитьПраваДоступаПользователя(ТехническийПользовательОбмена, ПользовательСсылка)
	
	ТаблицаТекущегоДоступаПользователя = ДанныеПоДоступамПользователя(ПользовательСсылка, Ложь);	
	
	ОбъектПользовательОбмена = ТехническийПользовательОбмена.ПолучитьОбъект();	
	
	// Проверка на наличие пользователя в исключениях.
	ЭтотПользовательИсключенИзОбработки = ПользовательВСпискеИсключений(ПользовательСсылка);
	Если ЭтотПользовательИсключенИзОбработки Тогда
		// Пользователь в списке исключений, права не трогаем.
		ОбъектПользовательОбмена.ТребуетсяОбновлениеПравПользователя = Ложь;
		ОбъектПользовательОбмена.Записать();
		Возврат;	
	КонецЕсли;
	
	// Создание новой таблицы доступа пользователя для сравнения с текущей таблицей доступа. 
	МассивШаблонов = ОбъектПользовательОбмена.ПраваПользователяИзКупорос.ВыгрузитьКолонку("ШаблонДоступа");
	МассивШаблонов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивШаблонов);
	
	РеквизитыШаблонов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивШаблонов, "ПользовательШаблон, Использовать");
	
	МассивПользователейИзШаблонов = Новый Массив;
	Для каждого ТекСтрока Из РеквизитыШаблонов Цикл
	
		Если Не ТекСтрока.Значение["Использовать"] Тогда
			Продолжить;
		КонецЕсли;
		
		МассивПользователейИзШаблонов.Добавить(ТекСтрока.Значение["ПользовательШаблон"]);
	
	КонецЦикла;
	
	ТаблицаНовогоДоступаПользователя = ДанныеПоДоступамПользователя(МассивПользователейИзШаблонов, Ложь);
	
	// Сравнение таблицы текущей с новым доступом на отличия.
	ТаблицаИзменений = КП_ОбщегоНазначенияКупорос.РазницаТаблицЗначений(ТаблицаТекущегоДоступаПользователя, ТаблицаНовогоДоступаПользователя);
	
	Если ТаблицаИзменений.Количество() = 0 Тогда
	    // Отличий нет, обновлять права не требуется.
		ОбъектПользовательОбмена.ТребуетсяОбновлениеПравПользователя = Ложь;
		ОбъектПользовательОбмена.Записать();
		Возврат;	
	КонецЕсли;
	
	// Обновление прав по таблице изменений.
	ЛитералЕстьТолькоВТаблицеТекущей = 0;

	Для каждого ТекИзменение Из ТаблицаИзменений Цикл
		
		ПараметрыПрав = Новый Структура;
		ПараметрыПрав.Вставить("ГруппаДоступа", ТекИзменение.ГруппаДоступа);
		ПараметрыПрав.Вставить("ГруппаПользователя", ТекИзменение.ГруппаПользователя);
	
		Если ТекИзменение.Знак = ЛитералЕстьТолькоВТаблицеТекущей Тогда
			// Удаление прав пользователя.
			УдалитьПраваПользователю(ПользовательСсылка, ПараметрыПрав);
		Иначе
			// Добавление новых прав пользователю.
			ДобавитьПраваПользователю(ПользовательСсылка, ПараметрыПрав);	
			
		КонецЕсли;	
	
	КонецЦикла;	
	
	// Обновление прав по пользователю.
	УправлениеДоступомСлужебный.ОбновитьРолиПользователей(ПользовательСсылка);
	
	ОбъектПользовательОбмена.ТребуетсяОбновлениеПравПользователя = Ложь;
	ОбъектПользовательОбмена.Записать();
	
	// логирование
	СтрокаШаблоныДоступа = ?(ЗначениеЗаполнено(МассивШаблонов), СтрСоединить(МассивШаблонов, Символы.ПС + " - "), "нет шаблонов доступа"); 
    ТекущиеДанныеДоступа = СтрокаОписанияГруппДоступа(ПользовательСсылка);
	ТекущиеДанныеДоступа = ?(ЗначениеЗаполнено(ТекущиеДанныеДоступа), ТекущиеДанныеДоступа, "нет прав");
	
	ТекстИнформации = СтрШаблон(НСтр("ru = 'Обновлены права по шаблонам доступа 
                                      |%1, учетная запись %2. 
                                      |Шаблоны доступа: 
                                      |- %3
                                      |Актуальные права:
                                      |%4'"), 
		ТехническийПользовательОбмена.Наименование, ТехническийПользовательОбмена.УчетнаяЗаписьWindows, СтрокаШаблоныДоступа, ТекущиеДанныеДоступа); 
	
	ОбщегоНазначения.СообщитьПользователю(ТекстИнформации);
	
	КП_ОбщегоНазначенияКупорос.ЗаписьЖурналаРегистрацииРасширенная("Администрирование.УправлениеСетью.ОбновлениеПрав", 
		ТекстИнформации, 
		УровеньЖурналаРегистрации.Информация);
	
	// уведомление через чат-бота
	КП_УправлениеБотомVKTeams.ОтправитьСообщениеВГруппуУправлениеДоступомПользователей(ТекстИнформации);	
	
КонецПроцедуры 

// Добавить единичные права пользователю
//
// Параметры:
//  ПараметрыПрав	 - Структура - содержит свойства (минимум одно должно быть):
//		* ГруппаДоступа - СправочникСсылка.ГруппыДоступа
//		* ГруппаПользователя - СправочникСсылка.ГруппыПользователей - если указано и заполнено, то группа доступа не используется для добавления
//
Процедура ДобавитьПраваПользователю(ПользовательСсылка, ПараметрыПрав)

	ОбработатьПраваПользователя(ПользовательСсылка, ПараметрыПрав, "Добавить");
	
КонецПроцедуры 

// Удалить права пользователю
//
// Параметры:
//  ПараметрыПрав	 - Структура - содержит свойства (минимум одно должно быть):
//		* ГруппаДоступа - СправочникСсылка.ГруппыДоступа
//		* ГруппаПользователя - СправочникСсылка.ГруппыПользователей - если указано и заполнено, то группа доступа не используется
//
Процедура УдалитьПраваПользователю(ПользовательСсылка, ПараметрыПрав)
	
	ОбработатьПраваПользователя(ПользовательСсылка, ПараметрыПрав, "Удалить");

КонецПроцедуры 

Процедура ОбработатьПраваПользователя(ПользовательСсылка, ПараметрыПрав, ТипДействия)

	УдалятьПраваПользователей = РегистрыСведений.КП_ПараметрыСистемыУправленияДоступомПользователей.ЗначениеПараметра("УдалятьПраваПользователей");
	Если ТипДействия = "Удалить"
		И Не УдалятьПраваПользователей Тогда
		Возврат;	
	КонецЕсли;	
	
	Если ПараметрыПрав.Свойство("ГруппаПользователя")
		И ЗначениеЗаполнено(ПараметрыПрав.ГруппаПользователя) Тогда
		// обновление группы пользователя
		
		ГруппаПользователей = ПараметрыПрав.ГруппаПользователя.ПолучитьОбъект();
		
		НайденнаяСтрокаПользователи = ГруппаПользователей.Состав.Найти(ПользовательСсылка, "Пользователь");
		Если Не ТребуетсяОбработкаНайденнойСтрокиПользователя(ТипДействия, НайденнаяСтрокаПользователи) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипДействия = "Добавить" Тогда
			СтрокаПользователи = ГруппаПользователей.Состав.Добавить();
	        СтрокаПользователи.Пользователь = ПользовательСсылка;
		Иначе
			ГруппаПользователей.Состав.Удалить(НайденнаяСтрокаПользователи);
		КонецЕсли;
		ГруппаПользователей.Записать();
		
	Иначе	
		// обновление группы доступа
		ГруппаДоступа = ПараметрыПрав.ГруппаДоступа.ПолучитьОбъект();
		
		НайденнаяСтрокаПользователи = ГруппаДоступа.Пользователи.Найти(ПользовательСсылка, "Пользователь");
		Если Не ТребуетсяОбработкаНайденнойСтрокиПользователя(ТипДействия, НайденнаяСтрокаПользователи) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипДействия = "Добавить" Тогда
			СтрокаПользователи = ГруппаДоступа.Пользователи.Добавить();
			СтрокаПользователи.Пользователь = ПользовательСсылка;
		Иначе
			ГруппаДоступа.Пользователи.Удалить(НайденнаяСтрокаПользователи);
		КонецЕсли;
		ГруппаДоступа.Записать();
		
	КонецЕсли;

КонецПроцедуры

Функция ТребуетсяОбработкаНайденнойСтрокиПользователя(ТипДействия, НайденнаяСтрокаПользователи)
	
	Если ТипДействия = "Добавить" 
		И НайденнаяСтрокаПользователи <> Неопределено Тогда
		// уже ранее был добавлен.
		Возврат Ложь;
	КонецЕсли;
	Если ТипДействия = "Удалить" 
		И НайденнаяСтрокаПользователи = Неопределено Тогда
		// уже ранее был удален.
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

#КонецОбласти

#КонецОбласти