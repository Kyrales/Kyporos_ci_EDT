#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользуемоеИмяФайла = РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла;
	
	Файл = Новый Файл(ИспользуемоеИмяФайла);
	Путь = Файл.Путь;
	
	//Путь = "s:\END_USER\1C\Купорос\УправлениеДоступомПользователей\"; // Используем абсолютный путь где искать расширение.
	
	ПредставлениеРасширения = "Купорос: Управление доступом пользователей";
	
	ВерсияНовогоРасширения = "1.0.1.2";
    ВерсияРасширения = ВерсияНовогоРасширения;  
	
	ТребуемаяВерсияПлатформы = "8.3.18";
	ТребуемаяВерсияБСП = "2.3";
	ТребуемыйРежимСовместимости = "8.3.14";

	ОбновитьДанныеУстановленного();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Заголовок = "Установщик " + ПредставлениеРасширения;
	
	ТекущийШаг = 1;
	ОбновитьЭлементыФормы();
	
	Если РежимПакетнойУстановки() Тогда 
		
		ВозможнаУстановка = ПакетнаяУстановка();
		Если Не ВозможнаУстановка Тогда
			
			ЗаписатьЛогПакетнойУстановки();
			ЗавершитьРаботуСистемы(Ложь);
			
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

