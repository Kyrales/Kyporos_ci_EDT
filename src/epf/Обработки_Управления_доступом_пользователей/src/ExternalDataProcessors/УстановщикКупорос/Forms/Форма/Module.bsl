&НаСервере
Функция УстановленнаяБСП()
	
	Результат = Новый Структура;
	
	Установлена = Ложь;
	Совместима = Ложь;
	Версия = "";
	ИнтегрированаЧастично = Ложь;
	Проблемы = Новый СписокЗначений;
	
	ИмяМодуляСтандартныеПодсистемыСерверРусское = "СтандартныеПодсистемыСервер";
	ИмяМодуляСтандартныеПодсистемыСерверАнглийское = "StandardSubsystemsServer";
	
	ОбъектМодульСтандартныеПодсистемыСервер = Метаданные.ОбщиеМодули.Найти(ИмяМодуляСтандартныеПодсистемыСерверРусское);
	Если ОбъектМодульСтандартныеПодсистемыСервер <> Неопределено Тогда
		
		Установлена = Истина;
		АнглийскаяВерсия = Ложь;
		
	КонецЕсли;
	
	ОбъектМодульСтандартныеПодсистемыСервер = Метаданные.ОбщиеМодули.Найти(ИмяМодуляСтандартныеПодсистемыСерверАнглийское);
	Если ОбъектМодульСтандартныеПодсистемыСервер <> Неопределено Тогда
		
		Установлена = Истина;
		АнглийскаяВерсия = Истина;
		
	КонецЕсли;
	
	Если Установлена Тогда
		
		Если АнглийскаяВерсия Тогда 
			
			ИмяМодуляСтандартныеПодсистемыСервер = ИмяМодуляСтандартныеПодсистемыСерверАнглийское;
			ИмяМодуляПодключаемыеКоманды = "AttachableCommands";
			ИмяРолиАдминистраторСистемы = "SystemAdministrator";
			ИмяФункцииВерсияБиблиотеки = "LibraryVersion";
			
		Иначе
			
			ИмяМодуляСтандартныеПодсистемыСервер = ИмяМодуляСтандартныеПодсистемыСерверРусское;
			ИмяМодуляПодключаемыеКоманды = "ПодключаемыеКоманды";
			ИмяРолиАдминистраторСистемы = "АдминистраторСистемы";
			ИмяФункцииВерсияБиблиотеки = "ВерсияБиблиотеки";
			
		КонецЕсли;
		
		Версия = Вычислить(СтрШаблон("%1.%2()", ИмяМодуляСтандартныеПодсистемыСервер, ИмяФункцииВерсияБиблиотеки));
		
		Если Метаданные.ОбщиеМодули.Найти(ИмяМодуляПодключаемыеКоманды) = Неопределено Тогда
			
			Представление = НСтр("ru = 'Не интегрирован модуль ПодключаемыеКоманды'; en = 'AttachableCommands module not integrated'");
			ДобавитьПроблемуСовместимостиБСП(Проблемы, Представление);
			
		КонецЕсли;
		
		Если Метаданные.Роли.Найти(ИмяРолиАдминистраторСистемы) = Неопределено Тогда
			
			Представление = НСтр("ru = 'Не интегрирована роль АдминистраторСистемы'; en = 'SystemAdministrator role is not integrated'");
			ДобавитьПроблемуСовместимостиБСП(Проблемы, Представление);
			
		КонецЕсли;
		
		ИнтегрированаЧастично = ЗначениеЗаполнено(Проблемы);
		
		СовместимаяВерсия = (СравнениеВерсий(Версия, ТребуемаяВерсияБСП) <> -1);
		Если НЕ СовместимаяВерсия Тогда
			
			Представление = НСтр("ru = 'Требуется версия не ниже: %1'; en = 'Requires a version of at least: %1'");
			ДобавитьПроблемуСовместимостиБСП(Проблемы, Представление);
			
		КонецЕсли;
		
		Совместима = НЕ ИнтегрированаЧастично И СовместимаяВерсия;
		
	КонецЕсли;
	
	Результат.Вставить("Установлена", Установлена);
	Результат.Вставить("Версия", Версия);
	Результат.Вставить("Совместима", Совместима);
	Результат.Вставить("ИнтегрированаЧастично", ИнтегрированаЧастично);
	Результат.Вставить("Проблемы", Проблемы);
	Результат.Вставить("АнглийскаяВерсия", АнглийскаяВерсия);
	
	Возврат Результат;
	
КонецФункции

