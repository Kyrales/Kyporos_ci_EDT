&НаКлиенте
Процедура ЗаписатьЛогПакетнойУстановки()
	
	Индекс = СтрНайти(ПараметрЗапуска, КлючПакетнойУстановки());
	НачальныйИндекс = Индекс + СтрДлина(КлючПакетнойУстановки());
	
	ИндексНачала = Неопределено;
	ИндексКонца = Неопределено;
	Для Индекс = НачальныйИндекс По СтрДлина(ПараметрЗапуска) Цикл 
		
		Символ = Сред(ПараметрЗапуска, Индекс, 1);
		
		Если ИндексНачала = Неопределено
				И Символ = "/" Тогда
			Прервать;
		КонецЕсли;
		
		Если ИндексНачала = Неопределено
				И Символ = """" Тогда
				
			ИндексНачала = Индекс;
			Продолжить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИндексНачала)
				И Символ = """" Тогда
				
			ИндексКонца = Индекс;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИндексНачала = Неопределено
			ИЛИ ИндексКонца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПолноеИмяФайлаЛога = Сред(ПараметрЗапуска, ИндексНачала + 1, ИндексКонца - ИндексНачала - 1); 
		ЗаписьТекста = Новый ЗаписьТекста(ПолноеИмяФайлаЛога);
		
		Для Каждого Строка Из РезультатОперации Цикл 
			ЗаписьТекста.ЗаписатьСтроку(Строка.Представление);
		КонецЦикла;
		
		Для Каждого Строка Из Информация.ПолучитьЭлементы() Цикл 
			
			Если НЕ Строка.Критичное Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаписьТекста.ЗаписатьСтроку(Строка.Представление);
			
		КонецЦикла;
		
		ЗаписьТекста.Закрыть();
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

