КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	Если ТекущийШаг = 1 Тогда
		
		ТекущаяСтраница = Элементы.СтраницаНачальная;
		
	Иначе
		
		ТекущаяСтраница = Элементы.СтраницаРезультатУстановки;
		
	КонецЕсли;
	Элементы.Страницы.ТекущаяСтраница = ТекущаяСтраница;
	
	ИмеютсяКритичныеТребования = ИмеютсяКритичныеТребования();
	
	Элементы.УстановленныхВерсийНет.Видимость = Не УстановленоРасширение;
	Элементы.УстановленнаяВерсия.Видимость = УстановленоРасширение;
	
	Элементы.Назад.Видимость = (ТекущийШаг > 1);
	Элементы.Установить.Видимость = Не УстановленоРасширение И (ТекущийШаг = 1);
	Элементы.Обновить.Видимость = ДоступноОбновление() И (ТекущийШаг = 1);
	Элементы.Удалить.Видимость = УстановленоРасширение И (ТекущийШаг = 1);
	
	Если ДоступноОбновление() Тогда
		
		КнопкаПоУмолчанию = Элементы.Обновить;
		
	Иначе
		
		КнопкаПоУмолчанию = Элементы.Установить;
		
	КонецЕсли;
	
	КнопкаПоУмолчанию.КнопкаПоУмолчанию = Истина;
	КнопкаПоУмолчанию.Доступность = НЕ ИмеютсяКритичныеТребования;
	
	Элементы.ТабличныйДокументИдетОперация.Видимость = ИдетОперация;
	ОтображениеСостояния = Элементы.ТабличныйДокументИдетОперация.ОтображениеСостояния;
	ОтображениеСостояния.Видимость = Истина;
	ОтображениеСостояния.Картинка = Элементы.ДлительнаяОперация.Картинка;
	ОтображениеСостояния.Текст = Операция;
	
	Элементы.РезультатОперации.Видимость = Не ИдетОперация;
	Элементы.ГруппаПрименитьИзменения.Видимость = ЕстьИзмененияОжидающиеПрименения;

КонецПроцедуры

&НаКлиенте
Функция ИмеютсяКритичныеТребования()
	
	Результат = Ложь;
	Для Каждого СтрокаТребование Из Информация.ПолучитьЭлементы() Цикл 
		
		Если СтрокаТребование.Критичное Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьДанныеУстановленного()
	
	Расширение = НашеУстановленноеРасширение();
	УстановленоРасширение = (Расширение <> Неопределено);
	Если УстановленоРасширение Тогда
		
		УстановленнаяВерсия = Расширение.Версия;
		ИмяУстановленнойВерсии = Расширение.Имя;
		
	КонецЕсли;
	
	НайденныеРасширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", "УправляемаяКонсольОтчетов"));
	УстановленоРасширениеУправляемаяКонсольОтчетов = ЗначениеЗаполнено(НайденныеРасширения);
	
	ПроверитьТребованияУстановки();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьТребованияУстановки()
	
	Информация.ПолучитьЭлементы().Очистить();
	
	// Проверка платформы
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ВерсияПлатформы = СистемнаяИнформация.ВерсияПриложения;
	
	ДопустимаяВерсияПлатформы = (СравнениеВерсий(ВерсияПлатформы, ТребуемаяВерсияПлатформы) <> -1);
	Если Не ДопустимаяВерсияПлатформы Тогда
		
		Шаблон = НСтр("ru = 'Требуется платформа не ниже: %1'; en = 'Requires a platform of at least %1'");
		ДобавитьСтрокуТребование(СтрШаблон(Шаблон, ТребуемаяВерсияПлатформы), Элементы.КритичноеПредупреждение.Картинка, Истина);
		
	КонецЕсли;
	
	// Проверка режима совместимости
	РежимСовместимостиКонфигурации = Метаданные.РежимСовместимости;
	Если РежимСовместимостиКонфигурации = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
		
		РежимСовместимостиКонфигурации = "";
		
	Иначе
		
		РежимСовместимостиКонфигурации = СтрЗаменить(РежимСовместимостиКонфигурации, "Версия", "");
		РежимСовместимостиКонфигурации = СтрЗаменить(РежимСовместимостиКонфигурации, "_", ".");
		
	КонецЕсли;
	
	Если Не ДопустимыйРежимСовместимости(ТребуемыйРежимСовместимости) Тогда
		
		Шаблон = НСтр("ru = 'Требуется режим совместимости конфигурации не ниже: %1'; en = 'Requires a configuration compatibility mode of at least %1'");
		ДобавитьСтрокуТребование(СтрШаблон(Шаблон, ТребуемыйРежимСовместимости), Элементы.КритичноеПредупреждение.Картинка, Истина);
		
	КонецЕсли;
	
	// Проверка включена защита от опасных действий
	Если ПользователиИнформационнойБазы.ТекущийПользователь().ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях Тогда
		
		ДобавитьСтрокуТребование(НСтр("ru = 'Включена защита от опасных действий, рекомендуется отключить';
										|en = 'Protection against dangerous actions is enabled, it is recommended to disable'"),
										Элементы.ИнформацияУстановки.Картинка);
	КонецЕсли;
	
	// Проверка БСП
	УстановленнаяБСП = УстановленнаяБСП();
	Если УстановленнаяБСП.Установлена Тогда
		
		Если НЕ УстановленнаяБСП.Совместима Тогда
			
			Родитель = ДобавитьСтрокуТребование(НСтр("ru = 'Установленная библиотека стандартных подсистем (БСП) не совместима';
													|en = 'The library of standard subsystems (SSL) is not compatible'"),
										Элементы.ВажноеПредупреждение.Картинка);
			// Добавим проблемы совместимости							
			Для Каждого ПроблемаСовместимости Из УстановленнаяБСП.Проблемы Цикл 
											
				ДобавитьСтрокуТребование(ПроблемаСовместимости.Представление, Элементы.ВажноеПредупреждение.Картинка, , Родитель);
				
			КонецЦикла;							
										
		КонецЕсли;
		
	Иначе
		
		ДобавитьСтрокуТребование(НСтр("ru = 'Библиотека стандартных подсистем (БСП) не установлена';
									|en = 'The library of standard subsystems (SSL) is not installed'"),
										Элементы.ВажноеПредупреждение.Картинка);
		
	КонецЕсли;
	
	// Проверка установлена Управляемая консоль отчетов
	Если УстановленоРасширениеУправляемаяКонсольОтчетов Тогда
		
		ДобавитьСтрокуТребование(НСтр("ru = 'Установлено расширение ""Управляемая консоль отчетов"" рекомендуется не использовать';
										|en = 'The ""Managed Reporting Console"" extension is installed. It is recommended not to use'"),
										Элементы.ИнформацияУстановки.Картинка);
										
	КонецЕсли;
									
	ДобавитьСтрокуТребование(НСтр("ru = 'Расширение устанавливается с отключенными безопасным режимом и защитой от опасных действий';
								|en = 'The extension is installed with disabled safe mode and protection against dangerous actions'"),
								Элементы.ИнформацияУстановки.Картинка);
								
	ДобавитьСтрокуТребование(НСтр("ru = 'Не изменяет структуру данных'; en = 'Does not change data structure'"),
								Элементы.ИнформацияУстановки.Картинка);
	
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуТребование(Представление, Картинка, Критичное = Ложь, Родитель = Неопределено)
	
	Если Родитель = Неопределено Тогда
		Родитель = Информация;
	КонецЕсли;
	
	НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
	НоваяСтрока.Критичное = Критичное;
	НоваяСтрока.Картинка = Картинка;
	НоваяСтрока.Представление = Представление;
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиенте
Процедура НачатьОперацию(Представление, ИмяОбработчика)
	
	ТекущийШаг = 2;
	ИдетОперация = Истина;
	Операция = Представление;
	
	ОбновитьЭлементыФормы();
	
	ПодключитьОбработчикОжидания(ИмяОбработчика, 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьРезультатОперации(Результат)
	
	РезультатОперации.Очистить();
	
	Если ЗначениеЗаполнено(Результат) Тогда 
		
		ДобавитьСтрокуВРезультат(Результат, Элементы.КритичноеПредупреждение.Картинка);
		
	Иначе
		
		ЕстьИзмененияОжидающиеПрименения = Истина;
		
		Шаблон = НСтр("ru = 'Операция: %1, выполнена успешно'; en = 'Operation: %1 completed successfully'");
		ДобавитьСтрокуВРезультат(СтрШаблон(Шаблон, Операция), Элементы.ВыполненоУспешно.Картинка);
		
	КонецЕсли;
	
	Если РежимПакетнойУстановки() Тогда
		
		ЗаписатьЛогПакетнойУстановки();
		ЗавершитьРаботуСистемы(Ложь);
		
	КонецЕсли;
	
	ИдетОперация = Ложь;
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйУдаление() Экспорт
	
	Результат = УдалитьРасширение();
	ОтобразитьРезультатОперации(Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УдалитьРасширение()
	
	Результат = Неопределено;
	
	Расширение = НашеУстановленноеРасширение();
	Если Расширение <> Неопределено Тогда
		
		Попытка
			
			Расширение.Удалить();
			
		Исключение
			
			Результат = ИнформацияОбОшибке().КраткоеПредставление;;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодключаемыйУстановка() Экспорт
	
	ЗагрузитьРасширение();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершенПоискФайлов(НайденныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(НайденныеФайлы) Тогда
		
		ДанныеРасширения = Новый ДвоичныеДанные(НайденныеФайлы[0].ПолноеИмя);
		Результат = УстановитьРасширение(ДанныеРасширения, ДополнительныеПараметры.Обновление);
		
	Иначе
		
		Шаблон = НСтр("ru = 'В поставке не найден файл: %1'; en = 'File not found in delivery: %1'");
		Результат = СтрШаблон(Шаблон, ДополнительныеПараметры.Маска);
		
	КонецЕсли;
	
	ОтобразитьРезультатОперации(Результат);
	
КонецПроцедуры

&НаСервере
Функция УстановитьРасширение(Данные, Обновление)
	
	Попытка
		
		Результат = Неопределено;
		
		Если Обновление Тогда
			Расширение = НашеУстановленноеРасширение();
		Иначе 
			Расширение = РасширенияКонфигурации.Создать();		
		КонецЕсли;
		
		Расширение.БезопасныйРежим = Ложь;
		
		ОписаниеЗащитыОтОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий;
		ОписаниеЗащитыОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		Расширение.ЗащитаОтОпасныхДействий = ОписаниеЗащитыОтОпасныхДействий;
		
		Расширение.Записать(Данные);
		
	Исключение
		
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодключаемыйОбновить() Экспорт
	
	ЗагрузитьРасширение(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВРезультат(Представление, Картинка)
	
	НоваяСтрока = РезультатОперации.Добавить();
	НоваяСтрока.Картинка = Картинка;
	НоваяСтрока.Представление = Представление
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СравнениеВерсий(Версия, ПроверяемаяВерсия)

	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат -1;
	КонецЕсли;
	
	МассивВерсия = СтрРазделить(Версия, ".");
	МассивПроверяемаяВерсия = СтрРазделить(ПроверяемаяВерсия, ".");

	Результат = 0;
	Для Счетчик = 0 По МассивПроверяемаяВерсия.ВГраница() Цикл
		
		Если Число(МассивВерсия[Счетчик]) > Число(МассивПроверяемаяВерсия[Счетчик]) Тогда
			
			Результат = 1; 
			Прервать;
			
		ИначеЕсли Число(МассивВерсия[Счетчик]) < Число(МассивПроверяемаяВерсия[Счетчик]) Тогда
			
			Результат = -1;
			Прервать;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция НашеУстановленноеРасширение()
	
	ИменаРасширения = Новый Массив;
	ИменаРасширения.Добавить("УправлениеДоступомПользователей");
	
	Результат = Неопределено;
	
	Для Каждого ИмяРасширения Из ИменаРасширения Цикл 
		
		Отбор = Новый Структура("Имя", ИмяРасширения);
		НайденныеРасширения = РасширенияКонфигурации.Получить(Отбор);
		
		Если ЗначениеЗаполнено(НайденныеРасширения) Тогда
			
			Результат = НайденныеРасширения[0];
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьРасширение(Обновление = Ложь)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Обновление", Обновление);
	
	ИмяПродукта = ИмяПродукта();
	УстановленнаяБСП = УстановленнаяБСП();
	
	Если УстановленнаяБСП.Совместима Тогда
		
		Если УстановленнаяБСП.АнглийскаяВерсия Тогда
			ТипВерсии = "SSL_ENG";
		Иначе
			ТипВерсии = "SSL_RU";
		КонецЕсли;

	Иначе
		ТипВерсии = "NO_SSL";
	КонецЕсли;
	Маска = СтрШаблон("%1.cfe", ИмяПродукта);
	
	ДополнительныеПараметры.Вставить("Маска", Маска);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенПоискФайлов", ЭтотОбъект, ДополнительныеПараметры);
	НачатьПоискФайлов(ОписаниеОповещения, Путь, Маска);

