&НаКлиенте
Процедура УдалитьОбъектыРасширения(Путь, Объекты)
	
	// ConfigDumpInfo.xml
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ПолноеИмяXMLФайла = Путь + "\ConfigDumpInfo.xml";
	ТекстовыйДокумент.Прочитать(ПолноеИмяXMLФайла);
	НовыйТекст = ТекстовыйДокумент.ПолучитьТекст();
	
	Для Каждого ОписаниеОбъекта Из Объекты Цикл 
		
		ТипОбъекта = ОписаниеОбъекта.Значение;
		ИмяОбъекта = ОписаниеОбъекта.Представление;
		
		ИскомаяСтрока = СтрШаблон("%1.%2", ТипОбъекта, ИмяОбъекта);
		Индекс = СтрНайти(НовыйТекст, ИскомаяСтрока);
		Если ЗначениеЗаполнено(Индекс) Тогда
			
			НачалоСтроки = СтрНайти(НовыйТекст, Символы.ПС, НаправлениеПоиска.СКонца, Индекс);
			КонецСтроки = СтрНайти(НовыйТекст, Символы.ПС, , Индекс);
			
			НовыйТекст = Лев(НовыйТекст, НачалоСтроки) + Сред(НовыйТекст, КонецСтроки + 1);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстовыйДокумент.УстановитьТекст(НовыйТекст);
	ТекстовыйДокумент.Записать(ПолноеИмяXMLФайла);
	
	// Configuration.xml
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ПолноеИмяXMLФайла = Путь + "\Configuration.xml";
	ТекстовыйДокумент.Прочитать(ПолноеИмяXMLФайла);
	НовыйТекст = ТекстовыйДокумент.ПолучитьТекст();
	
	Для Каждого ОписаниеОбъекта Из Объекты Цикл 
	
		ТипОбъекта = ОписаниеОбъекта.Значение;
		ИмяОбъекта = ОписаниеОбъекта.Представление;
		
		НовыйТекст = СтрЗаменить(НовыйТекст, СтрШаблон("<%1>%2</%1>", ТипОбъекта, ИмяОбъекта), "");
		
		Если ТипОбъекта = "Language" И ИмяОбъекта = "Русский" Тогда
			НовыйТекст = СтрЗаменить(НовыйТекст, "<DefaultLanguage>Language.Русский</DefaultLanguage>", "<DefaultLanguage>Language.Английский</DefaultLanguage>");
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстовыйДокумент.УстановитьТекст(НовыйТекст);
	ТекстовыйДокумент.Записать(ПолноеИмяXMLФайла);
	
	// Удаление команд в подсистемах
	НайденныеФайлы = НайтиФайлы(Путь + "\Subsystems", "CommandInterface.xml", Истина);
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл 
		
		ПолноеИмяФайла = НайденныйФайл.ПолноеИмя;
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ПолноеИмяФайла);
		НовыйТекст = ТекстовыйДокумент.ПолучитьТекст();
		
		Для Каждого ОписаниеОбъекта Из Объекты Цикл 
			
			ТипОбъекта = ОписаниеОбъекта.Значение;
			ИмяОбъекта = ОписаниеОбъекта.Представление;
			
			НачальныйБлок = СтрШаблон("<Command name=""%1.%2"">", ТипОбъекта, ИмяОбъекта);
			НачалоБлока = СтрНайти(НовыйТекст, НачальныйБлок);
			Если ЗначениеЗаполнено(НачалоБлока) Тогда
				
				КонечныйБлок = "</Command>";
				КонецБлока = СтрНайти(НовыйТекст, КонечныйБлок, , НачалоБлока);
				
				НовыйТекст = Лев(НовыйТекст, НачалоБлока - 1) + Сред(НовыйТекст, КонецБлока + СтрДлина(КонечныйБлок)+ 3);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТекстовыйДокумент.УстановитьТекст(НовыйТекст);
		ТекстовыйДокумент.Записать(ПолноеИмяФайла);
		
	КонецЦикла;
	
КонецПроцедуры

