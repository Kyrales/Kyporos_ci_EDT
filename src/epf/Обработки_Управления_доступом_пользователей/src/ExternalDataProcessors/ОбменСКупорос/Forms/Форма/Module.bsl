КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПользователи()
	
	  Запрос = Новый Запрос;
	  Запрос.Текст = "ВЫБРАТЬ
	                 |	Пользователи.Ссылка КАК Пользователь,
	                 |	Пользователи.Недействителен КАК Недействителен,
	                 |	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
	                 |	ЛОЖЬ КАК АутентификацияСтандартная,
	                 |	ЛОЖЬ КАК АутентификацияОС,
	                 |	ЛОЖЬ КАК АутентификацияOpenIDConnect,
	                 |	""                                      "" КАК ПользовательОС,
	                 |	""                                      "" КАК Комментарий
	                 |ИЗ
	                 |	Справочник.Пользователи КАК Пользователи
	                 |ГДЕ
	                 |	НЕ Пользователи.ПометкаУдаления
	                 |
	                 |УПОРЯДОЧИТЬ ПО
	                 |	Пользователи.Наименование";
	  
	  //Запрос.Текст = СтрЗаменить(Запрос.Текст, "Пользователи.Недействителен КАК Недействителен", 
	  //	"Пользователи.Недействителен КАК Недействителен, Пользователи.КП_ТехническийПользователь КАК КП_ТехническийПользователь");
	  
	  Результат = Запрос.Выполнить();
	  Выборка = Результат.Выгрузить();
	  
	  Для каждого ТекСтрока Из Выборка Цикл
	  
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
			ТекСтрока.ИдентификаторПользователяИБ);	
		Если ПользовательИБ <> Неопределено Тогда
			//ТекСтрока.АутентификацияСтандартная = ПользовательИБ.АутентификацияСтандартная;
			ЗаполнитьЗначенияСвойств(ТекСтрока, ПользовательИБ);
		Иначе
			ТекСтрока.Комментарий = НСтр("ru = 'Пользователь ИБ не определен.'")
		КонецЕсли;	
	  
	  КонецЦикла;
	  
	  Пользователи.Загрузить(Выборка);

КонецПроцедуры 

&НаСервере
Процедура СохранитьИзмененияНаСервере()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Изменить", Истина);
	
	НайденныеСтроки = Пользователи.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
	
		ОбъектДанных = ТекСтрока.Пользователь.ПолучитьОбъект();
		ОбъектДанных["КП_ТехническийПользователь"] = ТекСтрока.КП_ТехническийПользователь;
		ОбъектДанных.Записать();
		
		ТекСтрока.Изменить = Ложь;
		
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сохранение выбранных пользователей успешно.'"));
	
КонецПроцедуры

