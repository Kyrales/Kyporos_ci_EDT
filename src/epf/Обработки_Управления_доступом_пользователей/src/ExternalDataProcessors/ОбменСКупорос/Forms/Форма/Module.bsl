&НаСервере
Процедура СохранитьПараметрыНаСервере()

	МенеджерЗаписи = РегистрыСведений["КП_ПараметрыСистемыУправленияДоступомПользователей"].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ЭтаФорма);
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ПроверкаПодключенияККупоросНаСервере()
	
	Если Не ЗначениеЗаполнено(ИД_ТекущейСистемы) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АдресВебСервисаКупорос) Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбменДаннымиКупорос = ОбщегоНазначения.ОбщийМодуль("КП_ОбменДаннымиКупорос");
	Попытка
		
		РезультатПодключения = МодульОбменДаннымиКупорос.ПроверкаПодключенияККупорос();
		
	Исключение
		
		РезультатПодключения = Ложь;
		
		ТекстОшибкиПодключения = НСтр("ru = 'Ошибка подключения к веб-сервису Купорос. 
                            |%1'"); 
		ТекстОшибкиПодключения = СтрШаблон(ТекстОшибкиПодключения, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	Если РезультатПодключения Тогда
		НоваяВерсия = МодульОбменДаннымиКупорос.НоваяВерсия();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ФормированиеАктуальногоСпискаПользователейТекущийИСНаСервере()
	
	МодульОбменДаннымиКупорос = ОбщегоНазначения.ОбщийМодуль("КП_ОбменДаннымиКупорос");
	МодульОбменДаннымиКупорос.ФормированиеАктуальногоСпискаПользователейТекущийИС();
	
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Данные успешно обработаны.%1'"), "");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Процедура ОбновлениеДоступаПользователейНаСервере()
	
	Сообщения = "";
	
	МодульОбменДаннымиКупорос = ОбщегоНазначения.ОбщийМодуль("КП_УправлениеПравамиДоступа");
	МодульОбменДаннымиКупорос.ОбработкаПользователейНаДоступ(ТолькоИнформацияНаДоступПользователей, Сообщения);
	
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Данные успешно обработаны.%1'"), "");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

