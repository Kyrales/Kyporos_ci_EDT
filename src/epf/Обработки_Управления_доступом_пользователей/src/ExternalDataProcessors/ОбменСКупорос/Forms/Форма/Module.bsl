&НаКлиенте
Процедура РезультатПодключенияВыводСообщения()

	ТекстСообщения = СтрШаблон(НСтр("ru = 'Результат подключения к Купорос: %1.'"), Формат(РезультатПодключения, "БЛ='Не подключается'; БИ=Успешно"));
	
	Если Не РезультатПодключения Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекстОшибкиПодключения;
	КонецЕсли;
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры 

